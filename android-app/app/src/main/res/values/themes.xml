<resources>
    <style name="Theme.TIHLearning" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#E31E24</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.TIHLearning.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TIHLearning</item>
    </style>
</resources>
